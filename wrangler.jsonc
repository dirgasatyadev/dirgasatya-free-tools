{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dirgasatya-free-tools",
  "compatibility_date": "2026-08-19",
  "routes": [
    {
      "pattern": "tools.dirgasatya.id",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
