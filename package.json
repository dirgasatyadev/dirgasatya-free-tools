{
  "name": "dearga-free-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "test:unit": "vitest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium webkit",
    "icons:generate": "node scripts/generate-icon-subset.mjs",
    "icons:check": "node scripts/generate-icon-subset.mjs --check",
    "build-only": "npm run icons:check && vite build && node scripts/generate-seo.mjs && npm run bundle:report",
    "bundle:report": "node scripts/report-bundle-size.mjs",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:oxlint lint:eslint",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "lint:check": "run-s lint:check:oxlint lint:check:eslint",
    "lint:check:oxlint": "oxlint .",
    "lint:check:eslint": "eslint ."
  },
  "dependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/vue": "^5.0.1",
    "@jsquash/avif": "^2.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@zip.js/zip.js": "^2.8.53",
    "browser-image-compression": "^2.0.2",
    "cropperjs": "^2.1.1",
    "esbuild-wasm": "^0.25.12",
    "hash-wasm": "^4.12.0",
    "html-minifier-terser": "^7.2.0",
    "jsonpath-plus": "^10.4.0",
    "pinia": "^4.0.2",
    "prettier": "^3.9.6",
    "sql-formatter": "^15.8.2",
    "svgo": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.23",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.7.0",
    "eslint-plugin-oxlint": "~1.73.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.2",
    "oxlint": "~1.73.0",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
